# ==========================================
# Viralyst Environment Variables
# ==========================================

# Redis Configuration (Used by FastAPI API and Go Worker Engine)
REDIS_URL=redis://localhost:6379

# Worker Concurrency (Number of parallel goroutines processing persona evaluations)
WORKER_CONCURRENCY=10

# Groq API Keys Configuration (Optional, enables LLM-powered persona reasoning)
# Single Key:
GROQ_API_KEY=your_groq_api_key_here

# Optional: Multi-Key Load Balancing (Viralyst automatically alternates across keys for 60+ RPM and 429 failover)
# GROQ_API_KEY_1=gsk_key1...
# GROQ_API_KEY_2=gsk_key2...
# Or comma-separated:
# GROQ_API_KEYS=gsk_key1...,gsk_key2...

# Groq model used for persona decisions (llama-3.1-8b-instant has been retired)
# GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini keys join the same round-robin rotation for persona, topic and hook calls
# (video analysis stays on Groq). Same forms: GEMINI_API_KEY, _1.._10, or GEMINI_API_KEYS.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic (Claude) keys join the same rotation. Organization-level keys (not scoped to a
# workspace) also need the workspace ID from the Anthropic Console.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# ANTHROPIC_MODEL=claude-opus-5-5

# Video analysis (needs ffmpeg and a Groq key): first-3s frames → vision model, audio → Whisper
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
