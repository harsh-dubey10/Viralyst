# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# Groq API Keys (Supports single or multiple keys for alternating round-robin and 429 failover)
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
# GROQ_API_KEY=your_groq_api_key_here  # (single key also supported)

REDIS_URL=localhost:6379
WORKER_CONCURRENCY=10
