# ==========================================
# Viralyst Go Worker Configuration
# ==========================================

REDIS_URL=localhost:6379
WORKER_CONCURRENCY=10

# Groq LLM API Keys (Supports single, numbered, or comma-separated keys)
GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_KEY_1=gsk_...
# GROQ_API_KEY_2=gsk_...
# GROQ_API_KEYS=gsk_...,gsk_...

# Groq model used for persona decisions (llama-3.1-8b-instant has been retired)
# GROQ_MODEL=openai/gpt-oss-20b

# Video analysis (needs ffmpeg on PATH and at least one Groq key).
# Frames from the first 3s go to a vision model; the audio goes to Whisper.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Where the API saves uploads (default: ../api/uploads, relative to worker/)
# UPLOAD_DIR=../api/uploads
